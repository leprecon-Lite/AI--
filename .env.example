# GigaChat API — получите на https://developers.sber.ru
GIGA_PASSWORD=your_authorization_key_here

GIGA_MODEL=GigaChat-3-Ultra
GIGA_SCOPE=GIGACHAT_API_PERS
GIGA_BASE_URL=https://api.giga.chat/v1

# Сервисные настройки (для локального запуска)
GIGA_SERVICE_URL=http://127.0.0.1:8001
APP_PORT=8000
GIGA_PORT=8001
HTTP_TIMEOUT=120.0

# Логи
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log